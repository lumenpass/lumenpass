minimum_macos_version = '12.0'
platform :osx, minimum_macos_version

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

# google_sign_in is only supported on iOS / Android in this app. The
# google_sign_in_ios pod was being pulled into the macOS build via
# `shared_darwin_source`, but Flutter does NOT auto-link FlutterMacOS into
# arbitrary plugin pods, which left FLTGoogleSignInPlugin's symbols unresolved
# at link time. Strip the plugin from the macOS `.flutter-plugins-dependencies`
# entry AND from `GeneratedPluginRegistrant.swift` so neither CocoaPods nor
# the Swift compiler try to use it on macOS.
require 'json'
excluded_macos_plugins = ['google_sign_in_ios']
excluded_macos_plugin_classes = { 'google_sign_in_ios' => 'FLTGoogleSignInPlugin' }

plugins_file = File.expand_path(File.join('..', '.flutter-plugins-dependencies'), __dir__)
if File.exist?(plugins_file)
  data = JSON.parse(File.read(plugins_file))
  macos_plugins = data.dig('plugins', 'macos')
  if macos_plugins.is_a?(Array)
    filtered = macos_plugins.reject { |p| excluded_macos_plugins.include?(p['name']) }
    if filtered.size != macos_plugins.size
      data['plugins']['macos'] = filtered
      File.write(plugins_file, JSON.pretty_generate(data))
    end
  end
end

registrant_file = File.expand_path(File.join('Flutter', 'GeneratedPluginRegistrant.swift'), __dir__)
if File.exist?(registrant_file)
  contents = File.read(registrant_file)
  excluded_macos_plugins.each do |plugin|
    contents = contents.gsub(/^import #{Regexp.escape(plugin)}\n/, '')
    plugin_class = excluded_macos_plugin_classes[plugin]
    if plugin_class
      contents = contents.gsub(/^\s*#{Regexp.escape(plugin_class)}\.register\([^)]*\)\)\n/, '')
    end
  end
  File.write(registrant_file, contents)
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = minimum_macos_version

      # Match App Store / Organizer symbol upload expectations for pod frameworks.
      if config.name == 'Release' || config.name == 'Profile'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
      end
    end
  end

  # Patch GIDSignIn to use the data-protection keychain (iOS-style, per-app) instead of the
  # legacy macOS login keychain. Without this, SecItemAdd fails in the macOS sandbox on
  # Sequoia (and potentially earlier versions) because sandboxed apps cannot write to the
  # shared login keychain without a user prompt.
  gid_sign_in_path = File.join(installer.sandbox.root, 'GoogleSignIn/GoogleSignIn/Sources/GIDSignIn.m')
  if File.exist?(gid_sign_in_path)
    content = File.read(gid_sign_in_path)
    old_init = '[[GTMKeychainStore alloc] initWithItemName:kGTMAppAuthKeychainName];'
    new_init = '[[GTMKeychainStore alloc] initWithItemName:kGTMAppAuthKeychainName' \
               ' keychainAttributes:[NSSet setWithObject:[GTMKeychainAttribute useDataProtectionKeychain]]];'
    if content.include?(old_init)
      system("chflags nouchg '#{gid_sign_in_path}' && chmod u+w '#{gid_sign_in_path}'")
      File.write(gid_sign_in_path, content.gsub(old_init, new_init))
      puts "Patched GIDSignIn.m to use useDataProtectionKeychain"
    end
  end
end
