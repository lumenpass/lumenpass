  "children": [
    {
      "id": "lumenpass_design_system",
      "type": "frame",
      "name": "LumenPass / Design System",
      "x": 80,
      "y": 80,
      "width": 1600,
      "height": "fit_content(2400)",
      "layout": "vertical",
      "gap": 24,
      "padding": [
        32,
        32,
        40,
        32
      ],
      "fill": {
        "type": "gradient",
        "gradientType": "linear",
        "rotation": 180,
        "colors": [
          {
            "color": "#101A2F",
            "position": 0
          },
          {
            "color": "#0B1220",
            "position": 1
          }
        ]
      },
      "cornerRadius": 28,
      "stroke": {
        "align": "inside",
        "thickness": 1,
        "fill": "$--border"
      },
      "effect": [
        {
          "type": "shadow",
          "shadowType": "outer",
          "offset": {
            "x": 0,
            "y": 24
          },
          "blur": 80,
          "spread": 0,
          "color": "#02061766"
        }
